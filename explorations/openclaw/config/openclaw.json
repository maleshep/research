{
  "//": "OpenClaw config — WhatsApp agent backed by GLM-5.2-Vision on oneHPC. Copy to ~/.openclaw/openclaw.json and replace {{GLM_VISION_PORT}} with the current port from scripts/fleet-port.sh (8116 as of 2026-08-06).",

  "env": {
    "HPC_GLM_API_KEY": "any-non-empty-string"
  },

  "agents": {
    "defaults": {
      "model": { "primary": "hpc-glm/glm-5.2-vision" },
      "models": {
        "hpc-glm/glm-5.2-vision": { "alias": "GLM" }
      }
    }
  },

  "models": {
    "providers": {
      "hpc-glm": {
        "baseUrl": "http://localhost:{{GLM_VISION_PORT}}/v1",
        "apiKey": "${HPC_GLM_API_KEY}",
        "api": "openai-completions",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "glm-5.2-vision",
            "name": "GLM 5.2 Vision (HPC)",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 1000000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },

  "channels": {
    "whatsapp": {
      "dmPolicy": "pairing",
      "allowFrom": ["<AMAN_PHONE_E164>"],
      "groupPolicy": "disabled",
      "sendReadReceipts": false
    }
  },

  "bindings": [
    { "agentId": "main", "match": { "channel": "whatsapp", "accountId": "*" } }
  ]
}
